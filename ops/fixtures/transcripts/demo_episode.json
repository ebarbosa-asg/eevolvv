  "sentences": [
    {
      "id": "s01",
      "start_ms": 0,
      "end_ms": 4000,
      "speaker": "A",
      "text": "Send the full episode."
    },
    {
      "id": "s02",
      "start_ms": 4000,
      "end_ms": 8000,
      "speaker": "A",
      "text": "We listen for a moment that stands alone."
    },
    {
      "id": "s03",
      "start_ms": 8000,
      "end_ms": 12000,
      "speaker": "A",
      "text": "A strong hook names the tension first."
    },
    {
      "id": "s04",
      "start_ms": 12000,
      "end_ms": 16000,
      "speaker": "A",
      "text": "The cut starts and ends on a full thought."
    },
    {
      "id": "s05",
      "start_ms": 16000,
      "end_ms": 20000,
      "speaker": "A",
      "text": "Captions follow the words that were said."
    },
    {
      "id": "s06",
      "start_ms": 20000,
      "end_ms": 24000,
      "speaker": "A",
      "text": "That is the point of a careful clip."
    },
    {
      "id": "s07",
      "start_ms": 28000,
      "end_ms": 32000,
      "speaker": "A",
      "text": "The client approves before a post is queued."
    },
    {
      "id": "s08",
      "start_ms": 32000,
      "end_ms": 36000,
      "speaker": "A",
      "text": "A promise we cannot support waits for a person."
    },
    {
      "id": "s09",
      "start_ms": 36000,
      "end_ms": 40000,
      "speaker": "A",
      "text": "Rights are confirmed on the source file."
    },
    {
      "id": "s10",
      "start_ms": 40000,
      "end_ms": 44000,
      "speaker": "A",
      "text": "We only take files the client authorized."
    },
    {
      "id": "s11",
      "start_ms": 44000,
      "end_ms": 48000,
      "speaker": "A",
      "text": "The crop stays on the person speaking."
    },
    {
      "id": "s12",
      "start_ms": 48000,
      "end_ms": 52000,
      "speaker": "A",
      "text": "A long silent open is dropped."
    },
    {
      "id": "s13",
      "start_ms": 56000,
      "end_ms": 60000,
      "speaker": "A",
      "text": "Metadata points at sentences in the clip."
    },
    {
      "id": "s14",
      "start_ms": 60000,
      "end_ms": 64000,
      "speaker": "A",
      "text": "A title can stay short and still be clear."
    },
    {
      "id": "s15",
      "start_ms": 64000,
      "end_ms": 68000,
      "speaker": "A",
      "text": "Hashtags stay few so the caption is readable."
    },
    {
      "id": "s16",
      "start_ms": 68000,
      "end_ms": 72000,
      "speaker": "A",
      "text": "The same moment should not ship twice."
    },
    {
      "id": "s17",
      "start_ms": 72000,
      "end_ms": 76000,
      "speaker": "A",
      "text": "Loudness is checked before the clip moves on."
    },
    {
      "id": "s18",
      "start_ms": 76000,
      "end_ms": 80000,
      "speaker": "A",
      "text": "A person still reviews the cut."
    }
  ],
  "speakers": [
    "A"
  ]
}
