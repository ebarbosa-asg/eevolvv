# eevolvv — Environment Variables
# Copy this file to .env.local and fill in your keys

# ── Required ─────────────────────────────────────────────────────────────────

# Anthropic API — AI diagnostic engine
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Persistence (Supabase) ────────────────────────────────────────────────────
# Create a project at supabase.com, then run supabase/migrations/001_create_submissions.sql
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get your key at resend.com — verify your domain first
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=hello@eevolvv.com

# ── Error Tracking (Sentry) ──────────────────────────────────────────────────
# Create a Next.js project at sentry.io and grab the DSN
SENTRY_DSN=https://your_key@oXXXXXX.ingest.sentry.io/XXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://your_key@oXXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=eevolvv

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max diagnostic submissions per IP per hour (default: 3)
RATE_LIMIT_MAX=3

# ── CEO OS Hub (/os) ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
POSTHOG_PERSONAL_API_KEY=
GITHUB_TOKEN=

# ── Stripe (Payments) ────────────────────────────────────────────────────────
# Get from Stripe dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Stripe Price IDs (populated after T02 product creation) ─────────────────
STRIPE_PRICE_SEED_MONTHLY=price_...
STRIPE_PRICE_SEED_ANNUAL=price_...
STRIPE_PRICE_CORE_MONTHLY=price_...
STRIPE_PRICE_CORE_ANNUAL=price_...
STRIPE_PRICE_EVOLVE_MONTHLY=price_...
STRIPE_PRICE_EVOLVE_ANNUAL=price_...

# ── Cron Security ────────────────────────────────────────────────────────────
# Random secret — set same value in Vercel + vercel.json cron headers
CRON_SECRET=your_random_cron_secret_here

# ── Optional ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=your_google_analytics_id
